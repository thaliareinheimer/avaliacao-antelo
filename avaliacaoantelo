<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Avalie o atendimento</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    background: linear-gradient(135deg, #4f46e5, #0ea5e9); padding: 20px;
  }
  .card {
    background: #fff; border-radius: 20px; padding: 32px 24px; max-width: 420px; width: 100%;
    text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,.25);
  }
  .avatar {
    width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 16px;
    background: #eef2ff; color: #4f46e5; font-size: 36px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  h1 { font-size: 22px; margin: 0 0 6px; color: #111827; }
  p { color: #6b7280; margin: 0 0 24px; line-height: 1.5; }
  .btn {
    display: block; width: 100%; padding: 16px; border: 0; border-radius: 12px;
    background: #4f46e5; color: #fff; font-size: 17px; font-weight: 600; cursor: pointer;
    text-decoration: none;
  }
  .btn:hover { background: #4338ca; }
  .btn:disabled { background: #9ca3af; cursor: default; }
  .msg { margin-top: 18px; font-weight: 600; color: #059669; min-height: 22px; }
  .small { margin-top: 14px; font-size: 13px; color: #9ca3af; }
  .error { color: #dc2626; }
</style>
</head>
<body>
<div class="card">
  <div class="avatar" id="avatar">?</div>
  <h1 id="nome">Atendimento</h1>
  <p>Obrigado por ser atendido por <strong id="nome2"></strong>!<br>
     Sua avaliação no Google ajuda muito. Leva menos de 1 minuto.</p>

  <button class="btn" id="btn">⭐ Avaliar no Google</button>
  <div class="msg" id="msg"></div>
  <div class="small">Sua avaliação é pública no Google. Não há custo.</div>
</div>

<script>
/* ====== CONFIGURAÇÃO ====== */
// 1) Link de avaliação do seu negócio no Google (troque SEU_PLACE_ID)
const GOOGLE_REVIEW_URL = "https://www.google.com/maps/place/Antelo+Laborat%C3%B3rio+Cl%C3%ADnico/@-26.489694,-49.0807535,17z/data=!4m8!3m7!1s0x94de951d4439c78b:0x1a7ed2b66cfcfaf0!8m2!3d-26.489694!4d-49.0807535!9m1!1b1!16s%2Fg%2F11g_mshpc?entry=ttu&g_ep=EgoyMDI2MTAyMC4wIKXMDSoASAFQAw%3D%3D";
// 2) URL do Web App do Google Apps Script (passo 2 do guia)
const SHEET_API_URL = "https://script.google.com/macros/s/AKfycbyB6bZARslXEsmyA0FwFONyNg1plnTe1LqzLv2WpGlR5U0zLtowy6jIhUqmD28j2B0JWA/exec";
// 3) Nomes bonitos (opcional). A chave é o ?id= do QR Code.
const ATENDENTES = {
  mellanie: "Mellanie",
  thalia: "Thalia",
  brunamaria: "Bruna Maria",
  bruna: "Bruna",
  emily: "Emily",
  patrick: "Patrick",
  gabriely: "Gabriely",
  vitoria: "Vitória"
};
/* ========================== */

const params = new URLSearchParams(location.search);
const id = (params.get("id") || "").toLowerCase().trim();
const nome = ATENDENTES[id] || (id ? id.charAt(0).toUpperCase() + id.slice(1) : null);

const btn = document.getElementById("btn");
const msg = document.getElementById("msg");

if (!nome) {
  document.getElementById("nome").textContent = "QR Code inválido";
  document.getElementById("nome2").textContent = "nossa equipe";
  btn.disabled = true;
  msg.innerHTML = '<span class="error">Use o QR Code de um atendente.</span>';
} else {
  document.getElementById("avatar").textContent = nome.charAt(0).toUpperCase();
  document.getElementById("nome").textContent = nome;
  document.getElementById("nome2").textContent = nome;
}

// Evita contar o mesmo aparelho várias vezes no mesmo dia para o mesmo atendente
const LIMITE_DIARIO = false; // true = 1 ponto por dia por aparelho; false = sem limite
function jaContouHoje() {
  if (!LIMITE_DIARIO) return false;
  const key = "pontos_" + id;
  const hoje = new Date().toISOString().slice(0, 10);
  if (localStorage.getItem(key) === hoje) return true;
  localStorage.setItem(key, hoje);
  return false;
}

btn.addEventListener("click", async () => {
  // Abre a página de avaliação do Google em nova aba
  window.open(GOOGLE_REVIEW_URL, "_blank");

  if (!jaContouHoje()) {
    try {
      // no-cors: o Apps Script grava mesmo sem resposta legível no navegador
      await fetch(SHEET_API_URL + "?atendente=" + encodeURIComponent(nome), { mode: "no-cors" });
      msg.textContent = "✅ Ponto registrado para " + nome + "!";
    } catch (e) {
      msg.innerHTML = '<span class="error">Não foi possível registrar o ponto. Tente novamente.</span>';
      localStorage.removeItem("pontos_" + id);
    }
  } else {
    msg.textContent = "Obrigado! Você já avaliou hoje.";
  }
  btn.disabled = true;
});
</script>
</body>
</html>
